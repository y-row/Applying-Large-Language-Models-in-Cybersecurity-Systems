{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 1 Extraction Plan",
  "type": "object",
  "required": ["dataset_summary", "available_event_types", "recommended_tasks", "not_recommended_tasks"],
  "properties": {
    "dataset_summary": {"type": "string"},
    "available_event_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_type", "evidence", "support_level", "likely_fields", "sample_event_ids"],
        "properties": {
          "event_type": {"type": "string"},
          "evidence": {"type": "string"},
          "support_level": {"enum": ["high", "medium", "low"]},
          "likely_fields": {"type": "array", "items": {"type": "string"}},
          "sample_event_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "recommended_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_name", "priority", "reason", "target_event_types", "task_keywords", "required_fields"],
        "properties": {
          "task_name": {"type": "string"},
          "priority": {
            "type": "integer",
            "description": "Numeric usefulness score where larger numbers are higher priority. Use 100 for the best supported task, then lower scores for secondary tasks. This is not a rank; do not use 1 as the best task."
          },
          "reason": {"type": "string"},
          "target_event_types": {"type": "array", "items": {"type": "string"}},
          "task_keywords": {"type": "array", "items": {"type": "string"}},
          "required_fields": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "not_recommended_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_name", "reason"],
        "properties": {
          "task_name": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
